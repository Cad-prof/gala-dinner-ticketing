# ─── Supabase ─ https://supabase.com/dashboard/project/_/settings/api ───────
# 1) Exécuter supabase/migrations/0001_init.sql dans l'éditeur SQL du projet.
# 2) Renseigner l'URL du projet et la clé SECRÈTE (serveur uniquement !).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Clé secrète (sb_secret_… ou service_role). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ─── Wave Business ─ https://business.wave.com/dev-portal ───────────────────
# Créer une clé API Checkout avec la signature des requêtes activée.
WAVE_API_KEY=your_wave_api_key_here
WAVE_API_SIGNING_SECRET=your_wave_api_signing_secret_here
# Secret de signature distinct, fourni lors de l'enregistrement du webhook Wave.
WAVE_WEBHOOK_SECRET=your_wave_webhook_signing_secret_here
# Optionnel — uniquement si Wave vous fournit une URL d'API spécifique.
# WAVE_API_BASE_URL=https://api.wave.com
#
# URL de webhook à déclarer dans le portail Wave :
#   https://VOTRE-DOMAINE/api/webhooks/wave
# Pendant la migration seulement, conservez l'ancien secret webhook Bictorys
# jusqu'à l'expiration de tous ses checkouts en cours :
# BICTORYS_WEBHOOK_SECRET=your_legacy_bictorys_webhook_secret_here

# ─── Site ───────────────────────────────────────────────────────────────────
# URL publique HTTPS requise par l'API Checkout Wave, sans slash final.
# En local, utilisez une URL de tunnel HTTPS pour les redirections et webhooks.
NEXT_PUBLIC_BASE_URL=https://votre-domaine.com

# ─── Espace organisateur (/admin) ───────────────────────────────────────────
# Mot de passe pour consulter les commandes et valider les billets à l'entrée.
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long
