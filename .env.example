# ─── Supabase ─ https://supabase.com/dashboard/project/_/settings/api ───────
# 1) Exécuter supabase/migrations/0001_init.sql dans l'éditeur SQL du projet.
# 2) Renseigner l'URL du projet et la clé SECRÈTE (serveur uniquement !).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Clé secrète (sb_secret_… ou service_role). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ─── Bictorys ─ https://dashboard.bictorys.com → Développeurs ───────────────
# Clé publique : création du paiement (create_charge)
BICTORYS_API_KEY=your_bictorys_public_key_here
# Clé privée : vérification d'une transaction (verify_transaction)
BICTORYS_PRIVATE_KEY=your_bictorys_private_key_here
# Secret partagé : authentification des webhooks
BICTORYS_WEBHOOK_SECRET=your_bictorys_webhook_secret_here
# Optionnel — sandbox (clés de test distinctes de la production)
# BICTORYS_API_BASE_URL=https://api.test.bictorys.com
#
# URL de webhook à déclarer dans le dashboard Bictorys :
#   https://VOTRE-DOMAINE/api/webhooks/bictorys

# ─── Site ───────────────────────────────────────────────────────────────────
# URL publique (HTTPS obligatoire pour Bictorys hors localhost, sans slash final)
NEXT_PUBLIC_BASE_URL=https://votre-domaine.com

# ─── Espace organisateur (/admin) ───────────────────────────────────────────
# Mot de passe pour consulter les commandes et valider les billets à l'entrée.
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long
